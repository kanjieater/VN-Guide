# Claude subscription (default): keep ~/.claude mounted and log in with Claude CLI.
GUIDE_PROVIDER=claude
# Optional shared model override. Leave unset to use the provider's default.
# GUIDE_MODEL=claude-sonnet-5

# OpenRouter alternative (billed from your OpenRouter account, not Claude plan):
# GUIDE_PROVIDER=openrouter
# GUIDE_MODEL=stealth/union-alpha
# OPENROUTER_API_KEY=replace-me

# Optional per-role overrides take precedence over GUIDE_MODEL:
# GUIDE_GEN_MODEL=stealth/union-alpha
# GUIDE_AUTHOR_MODEL=stealth/union-alpha
# GUIDE_STRUCTURAL_REVIEWER_MODEL=stealth/union-alpha
# GUIDE_REVIEWER_MODEL=stealth/union-alpha

# Target only Himawari (generation and review); allow daytime runs:
# GUIDE_PRIORITY_VID=v210
# GUIDE_WINDOW_DISABLE=1
